{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "hnatekmar": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "qwen-coder",
      "options": {
        "baseURL": "https://llm.hnatekmar.dev/qwen-coder/v1"
